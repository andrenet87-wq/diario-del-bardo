        {
          "name": "Dregan",
          "img": "assets/characters/dregan.jpg",
          "x": 70
        }
      ],
      "dialogue": [
        {
          "speaker": "Lucien",
          "text": "Dregan e basta? Non hai un cognome?"
        },
        {
          "speaker": "Dregan",
          "text": "Il mio cognome… lo avevo un cognome, poi un giorno mi trovavo nell'arena. Ricevetti sul volto un pugno così forte e me lo scordai. Da allora non ne ho più uno."
        }
      ]
    },
    {
