{
  "scenes": [
    {
      "id": "R001",
      "title": "I travois",
      "place": "Deserto di Thrantir",
      "bg": "assets/placeholders/place.svg",
      "cast": [
        {
          "name": "Lucien",
          "img": "assets/characters/lucien_thrantir.png",
          "x": 31
        },
        {
          "name": "Xarion",
          "img": "assets/characters/xarion.jpg",
          "x": 67
        }
      ],
      "dialogue": [
        {
          "speaker": "Lucien",
          "text": "Lascia stare… non sono di molte parole. Ho chiesto perché queste barelle avessero delle lame per fendere la sabbia, mi hanno dato un pugno e sono tornati a trascinarci."
        },
        {
          "speaker": "Xarion",
          "text": "E perché hai chiesto una cosa così stupida!?"
        },
        {
          "speaker": "Lucien",
          "text": "Perché… Tu conosci la risposta?"
        }
      ]
    },
    {
      "id": "R002",
      "title": "Inception o Interstellar?",
      "place": "Deserto di Thrantir",
      "bg": "assets/placeholders/place.svg",
      "cast": [
        {
          "name": "Lucien",
          "img": "assets/characters/lucien_thrantir.png",
          "x": 30
        },
        {
          "name": "Xarion",
          "img": "assets/characters/xarion.jpg",
          "x": 70
        }
      ],
      "dialogue": [
        {
          "speaker": "Lucien",
          "text": "Tu l’hai visto Inception?"
        },
        {
          "speaker": "Xarion",
          "text": "Il film dell’era atomica!?"
        },
        {
          "speaker": "Lucien",
          "text": "Vedi, quello che stiamo osservando, è un buco nero!"
        },
        {
          "speaker": "Xarion",
          "text": "Interstellar. Matthew McConaughey."
        }
      ]
    },
